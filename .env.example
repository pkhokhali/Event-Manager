# Server
DATABASE_URL=postgresql://eventmanager:eventmanager@localhost:5432/eventmanager
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development
ADMIN_API_KEY=change-me-admin-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
ENABLE_CRON=true

# AWS S3 (optional for uploads)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=event-manager-uploads
AWS_S3_PUBLIC_URL=

# Firebase FCM (optional for push)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Admin
VITE_API_URL=http://localhost:4000/api/v1
