# Cloudflare Workers / local
ADMIN_API_KEY=change-me-admin-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# R2 (S3-compatible API tokens from Cloudflare dashboard)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=event-manager-uploads
R2_PUBLIC_URL=https://uploads.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Firebase FCM — full service account JSON as a single-line secret
# wrangler secret put FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_JSON=

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:8787/api/v1

# Admin (Vite / Pages)
VITE_API_URL=http://localhost:8787/api/v1
