{
  "name": "event-manager",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm run dev -w @event-manager/api",
    "dev:admin": "npm run dev -w @event-manager/admin",
    "dev:mobile": "npm run start -w @event-manager/mobile",
    "dev:push": "npm run dev -w @event-manager/push-consumer",
    "build": "npm run build -w @event-manager/shared && npm run build -w @event-manager/admin",
    "build:shared": "npm run build -w @event-manager/shared",
    "db:migrate:local": "npm run db:migrate:local -w @event-manager/api",
    "db:migrate:remote": "npm run db:migrate:remote -w @event-manager/api",
    "db:seed:local": "node scripts/seed-d1.mjs",
    "db:seed:remote": "node scripts/seed-d1.mjs --remote",
    "deploy:api": "npm run deploy -w @event-manager/api",
    "deploy:push": "npm run deploy -w @event-manager/push-consumer",
    "deploy:admin": "npm run deploy -w @event-manager/admin"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
