{
  "name": "event-manager",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "server",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:server": "npm run dev -w @event-manager/server",
    "dev:admin": "npm run dev -w @event-manager/admin",
    "dev:mobile": "npm run start -w @event-manager/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "npm run db:generate -w @event-manager/server",
    "db:migrate": "npm run db:migrate -w @event-manager/server",
    "db:seed": "npm run db:seed -w @event-manager/server",
    "db:push": "npm run db:push -w @event-manager/server"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
