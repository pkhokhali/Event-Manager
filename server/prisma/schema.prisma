generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VendorCategoryType {
  CATERING
  PHOTOGRAPHY
  DECORATOR
  MAKEUP
  MUSIC_BAND
  DJ
  VENUE
  PANDIT
  TRANSPORTATION
  SOUND_LIGHTING
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
  EMAIL
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model EventCategory {
  id            String             @id @default(uuid())
  slug          String             @unique
  nameEn        String
  nameNe        String
  icon          String?
  sortOrder     Int                @default(0)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  subcategories EventSubcategory[]

  @@index([isActive, sortOrder])
}

model EventSubcategory {
  id         String        @id @default(uuid())
  categoryId String
  slug       String
  nameEn     String
  nameNe     String
  sortOrder  Int           @default(0)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
  @@index([categoryId, isActive])
}

model Vendor {
  id          String             @id @default(uuid())
  name        String
  nameNe      String?
  description String?
  category    VendorCategoryType
  phone       String?
  email       String?
  website     String?
  address     String?
  city        String?
  latitude    Float?
  longitude   Float?
  priceMin    Float?
  priceMax    Float?
  rating      Float              @default(0)
  reviewCount Int                @default(0)
  isAvailable Boolean            @default(true)
  isFeatured  Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  media       VendorMedia[]
  reviews     VendorReview[]

  @@index([category, isAvailable])
  @@index([isFeatured])
  @@index([name])
}

model VendorMedia {
  id        String   @id @default(uuid())
  vendorId  String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorReview {
  id         String       @id @default(uuid())
  vendorId   String
  deviceId   String
  rating     Int
  title      String?
  comment    String?
  authorName String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  vendor     Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
  @@index([deviceId])
}

model Festival {
  id            String    @id @default(uuid())
  slug          String    @unique
  nameEn        String
  nameNe        String
  descriptionEn String?
  descriptionNe String?
  gregorianDate DateTime
  bikramDate    String?
  tithiLabel    String?
  muhurtaNote   String?
  isNational    Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([gregorianDate])
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  titleNe   String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
}

model FeaturedEvent {
  id          String    @id @default(uuid())
  title       String
  titleNe     String?
  description String?
  imageUrl    String?
  linkUrl     String?
  vendorId    String?
  festivalId  String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([isActive, sortOrder])
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  title     String
  body      String
  channel   NotificationChannel @default(PUSH)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  jobs      NotificationJob[]
}

model NotificationJob {
  id          String                @id @default(uuid())
  templateId  String?
  title       String
  body        String
  channel     NotificationChannel   @default(PUSH)
  status      NotificationJobStatus @default(PENDING)
  scheduledAt DateTime?
  sentAt      DateTime?
  error       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  template    NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([status, scheduledAt])
}

model DeviceToken {
  id        String   @id @default(uuid())
  deviceId  String
  fcmToken  String
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, fcmToken])
  @@index([deviceId])
}

model MediaFile {
  id          String   @id @default(uuid())
  key         String   @unique
  url         String
  contentType String
  sizeBytes   Int
  folder      String
  createdAt   DateTime @default(now())
}

model AppStat {
  id    String @id @default("global")
  key   String @unique
  value Int    @default(0)
}
